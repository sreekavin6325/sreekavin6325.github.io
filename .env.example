# Copy this file to .env.local and fill in your values.

# Public URL of the deployed site (used for SEO metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your email address (shown on the contact page as a fallback)
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Contact form → Google Sheets (see README: "Contact form → Google Sheets")
# The Apps Script web-app URL, ending in /exec
CONTACT_SHEET_URL=
# Must match SECRET in google-apps-script/contact-to-sheet.gs
CONTACT_SHEET_SECRET=
